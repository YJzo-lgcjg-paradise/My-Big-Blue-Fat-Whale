{
  "name": "dsh-memory-bridge",
  "version": "0.1.0",
  "description": "把 DeepSeek Harness 的对话窗口接到「大肥鱼」记忆库：每个窗口绑定一个记忆体，不再受原上下文牵制，只带最近的事件与十条对话进去。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "memory"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
